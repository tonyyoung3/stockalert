# Slack (screener + optional interactive bot)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_URL=

# Optional: override SQLite path
# SCREENER_DB=screener.db

# Agent harness (python -m harness "...")
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL=gpt-4o-mini

# Set to 1 to route non-ticker Slack messages through the harness
# HARNESS_ENABLED=0

# Turso (optional). When both are set, market-data and screener jobs copy local sqlite to the cloud DB.
# TURSO_DATABASE_URL=libsql://stockalert-org.turso.io
# TURSO_AUTH_TOKEN=
