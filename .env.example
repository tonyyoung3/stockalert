# Slack bot (screener alerts + interactive chart bot)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=C0123456789

# App-level token for Socket Mode (interactive_bot.py only)
SLACK_APP_TOKEN=xapp-your-app-token

# Optional. Defaults to screener.db next to the scripts.
# SCREENER_DB=/path/to/screener.db

# Optional pattern thresholds (screener.py)
# SHADOW_RATIO=1.5
# UPPER_SHADOW_MIN_PCT=0.02
# MIN_DAILY_GAIN=0.01
