# Slack (screener, daily PTT/Reddit digest, optional interactive bot).
# The weekday market-data job also uses these two to post failure logs.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_URL=

# Optional: override SQLite path
# SCREENER_DB=screener.db

# FinMind (熱門股分點動向, path A; also institutional gap fill). Placeholder only —
# never commit a real token.
# GitHub Actions uses the FINMIND_TOKEN secret (do not print or paste it here).
# Local: copy this file to .env and fill the token. Empty = honest empty / connect-token.
# institutional_gaps: all-stocks-by-start_date needs Backer/Sponsor; T86 from
# Actions IPs often returns empty/HTML. See docs/broker_branch.md.
FINMIND_TOKEN=
# BROKER_BRANCH_HOT_N=80

# Agent harness (python -m harness "...")
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL=gpt-4o-mini

# Set to 1 to route non-ticker Slack messages through the harness
# HARNESS_ENABLED=0

# Turso (optional). When both are set, market-data and screener jobs copy local sqlite to the cloud DB.
# The Cloud Run dashboard also reads these instead of twse_data.db.
# TURSO_DATABASE_URL=libsql://stockalert-org.turso.io
# TURSO_AUTH_TOKEN=

# Cloud Run / any PaaS: listen on $PORT (default 8765) and 0.0.0.0
# PORT=8080
# DASHBOARD_NO_BROWSER=1
# TWSE_DB=twse_data.db

# Dashboard HTTP Basic Auth. Both must be set to enable.
# Local (no K_SERVICE): missing auth = anonymous, still rate-limited.
# Cloud Run: set both secrets, or DASHBOARD_ALLOW_ANONYMOUS=1; otherwise
# HTML /api/* fail closed (GET /health stays open).
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
# DASHBOARD_ALLOW_ANONYMOUS=0
# DASHBOARD_FAIL_CLOSED=0
# DASHBOARD_BACKTEST_RPM=10
# DASHBOARD_BACKTEST_ANON_RPM=3

# Backtest compute_stats: n below this is flagged 樣本不足 (default 20).
# BACKTEST_MIN_TRADES=20
